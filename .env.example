# Copy this file to .env and fill in real values. Never commit .env.
# etl_common.py (ETL/write path) and api/database.py (API/read path) read
# ETL_DB_* directly; several scripts/build_*.py and scripts/*.py also accept
# the libpq-standard PG* names or a single DATABASE_URL as alternates.

# --- PostgreSQL "DuLieu" database ---
ETL_DB_NAME=DuLieu
ETL_DB_USER=postgres
ETL_DB_PASSWORD=
ETL_DB_HOST=localhost
ETL_DB_PORT=5433
# Alternate form some scripts accept instead of the ETL_DB_* vars above:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5433/DuLieu

# --- Gmail SMTP (staff scorecard + CEO report senders) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail App Password (not your normal Gmail password) — https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Hệ thống báo cáo LPM

# --- Daily run behavior ---
# 1 = do not actually send email; 0 = send for real
DRY_RUN=1
# Leave unset to let scripts default to "yesterday"
REPORT_DATE=
OUTBOX_DIR=outbox

# --- CEO Daily P&L VAT rates (optional, script-specific default applies if unset) ---
DAILY_PNL_VAT_RATES=

# --- Channel ETL raw-data source/output overrides (optional; each ETL has an in-repo default) ---
NHANH_BASE_IN=
NHANH_BASE_OUT=
SHOPEE_BASE_IN=
SHOPEE_BASE_OUT=
SHOPEE_RETURN_FEE_CANCELLED=
SHOPEE_GIFT_RULES_FILE=config/shopee_promotion_gift_rules_v4_7_4.csv
TIKTOK_BASE_IN=
TIKTOK_BASE_OUT=
MTGT_BASE_IN=
MTGT_BASE_OUT=
